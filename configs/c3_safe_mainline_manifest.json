{
  "protocol_version": "c3-safe-v0.1-planned",
  "decision_date": "2026-08-13",
  "status": "PLANNED_NOT_RUN",
  "mainline": {
    "name": "C3-Safe",
    "expanded_name": "Capability-Constraint Counterfactual Semantic Safety Distillation",
    "working_title": "Teach Requirements, Not Actions: Capability-Constraint Counterfactual Distillation for Semantic-Safe Control",
    "test_time_vlm": false,
    "teacher_receives_action": false,
    "teacher_receives_candidate_or_trajectory": false
  },
  "tasks": [
    "PointHazard",
    "SafetyPointGoal1-v0-semantic"
  ],
  "teacher": {
    "primary": {
      "model": "Qwen3-VL-8B-Instruct",
      "mode": "offline_action_free_requirement_labeling"
    },
    "sensitivity": {
      "model": "InternVL3-8B",
      "fraction_of_labels": 0.1,
      "is_core_result": false
    },
    "required_provenance": [
      "teacher_model",
      "teacher_revision",
      "prompt_sha256",
      "image_sha256",
      "response_sha256",
      "label_schema_version"
    ]
  },
  "student": {
    "requirement_encoder": "resnet18_or_small_cnn",
    "capability_rule_encoder": "mlp",
    "semantic_cost": "factorized_requirement_capability_rule_head",
    "policy": "gaussian_sac_lagrangian",
    "runtime_dependencies": ["numpy", "Pillow"]
  },
  "capability_axes": [
    "waterproof",
    "mud_rough_terrain_mobility",
    "footprint_clearance_optional_physics_axis"
  ],
  "rules": [
    "avoid_water",
    "avoid_mud",
    "protect_fragile_terrain"
  ],
  "splits": {
    "appearance": "disjoint_texture_color_templates_and_geometry_seeds",
    "capability": "train_three_of_four_binary_axis_combinations_test_the_fourth",
    "rule": "train_seen_combinations_test_unseen_rule_combinations",
    "joint_ood": "unseen_appearance_x_unseen_capability_x_unseen_rule"
  },
  "scale": {
    "teacher_labelled_frames_per_task": "2000-5000",
    "rl_seeds": 5,
    "evaluation_episodes_per_seed_split": 100,
    "teacher_manual_review_images": 200
  },
  "metrics": [
    "safe_task_completion",
    "episode_semantic_violation_rate",
    "semantic_violation_steps",
    "native_physical_cost",
    "task_success",
    "return",
    "critic_auroc",
    "critic_auprc",
    "critic_fnr",
    "critic_ece",
    "inference_latency",
    "parameter_count"
  ],
  "gates": {
    "gate0": {
      "seed_geometry_rgb_hash_overlap": 0,
      "safety_gym_overlay_evaluator_agreement_min": 0.98,
      "provenance_complete": true
    },
    "gate1": {
      "teacher_requirement_macro_f1_min": 0.8,
      "risk_flip_accuracy_min": 0.8,
      "student_heldout_auroc_min": 0.85,
      "student_ece_max": 0.1,
      "student_auroc_margin_over_non_vlm_min": 0.05
    },
    "gate2": {
      "joint_ood_violation_relative_reduction_min": 0.25,
      "joint_ood_stc_absolute_gain_min": 0.08,
      "success_absolute_drop_max": 0.05,
      "native_collision_absolute_increase_max": 0.02,
      "counterfactual_ablation_violation_relative_increase_min": 0.1,
      "seeds_min": 5,
      "confidence_interval_must_exclude_zero": true
    }
  },
  "baselines": [
    "reward_only_sac",
    "oracle_semantic_cost_sac_lagrangian",
    "no_vlm_domain_randomization_or_simulator_labels",
    "scalar_vlm_cost",
    "late_concat_critic",
    "generic_representation_distillation"
  ],
  "ablations": [
    "remove_matched_counterfactual_loss",
    "replace_factorized_interaction_with_late_concat",
    "remove_vlm_requirement_supervision"
  ],
  "result_policy": {
    "validated_results_before_first_run": false,
    "complete_manifest_is_not_science_validation": true,
    "historical_results_are_not_inherited": true
  }
}
