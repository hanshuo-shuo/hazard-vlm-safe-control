# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Runtime-only advisory locks
*.json.lock

# OS
.DS_Store

# Large / reproducible binary artifacts (code-only repo)
# /hazard/ = historical model weights (.pt), gifs, run logs when old scripts rerun
# the preserved copy lives under legacy/runtime_artifacts/hazard/
# data/   = demos (.npz), diffusion checkpoints
# NOTE: outputs/ (result figures + small JSON logs, ~1.4M) IS tracked so the
# figures embedded in docs/ render on GitHub. Large binaries below stay ignored.
/hazard/
/legacy/runtime_artifacts/hazard/
data/
*.pt
*.npz
*.gif

# Small GIFs are part of the documented legacy research record.
!legacy/assets/*.gif

# C3 development runs retain local datasets and exact source snapshots.
# Reproduce them with scripts/*c3*.py; checked-in summaries live in docs/.
/results/c3_*/

# Three tiny, hash-verified reference heads make the composition audit executable.
!research/quest_reference/results/exp01ad_retrained_replication/checkpoints/dense_cost.pt
!research/quest_reference/results/exp01ad_retrained_replication/checkpoints/factorized_no_cf.pt
!research/quest_reference/results/exp01ad_retrained_replication/checkpoints/factorized_full.pt

# PDF render caches and intermediate QA scratch.
/tmp/pdfs/
